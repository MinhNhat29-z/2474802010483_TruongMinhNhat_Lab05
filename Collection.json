  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "1. POST - Create User (DDT users.csv)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const data = pm.response.json();\r",
                  "    pm.collectionVariables.set('duplicateEmailForRun', data.email);\r",
                  "    \r",
                  "\r",
                  "    pm.environment.set('userId', String(data.id));\r",
                  "    pm.environment.set('createdEmail', data.email);\r",
                  "    pm.environment.set('runEmail', data.email);\r",
                  "\r",
                  "    pm.test('Response contains expected user data', function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.name).to.eql(pm.iterationData.get('name'));\r",
                  "    pm.expect(json.gender).to.eql(pm.iterationData.get('gender'));\r",
                  "    pm.expect(json.status).to.eql(pm.iterationData.get('status'));\r",
                  "    pm.expect(json.email).to.eql(pm.environment.get('runEmail'));\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseEmail = pm.iterationData.get('email') || 'demo@example.com';\r",
                  "const uniqueEmail = baseEmail.replace('@', `.${Date.now()}.${pm.info.iteration}@`);\r",
                  "\r",
                  "pm.environment.set('runEmail', uniqueEmail);\r",
                  "pm.environment.unset('userId');\r",
                  "pm.environment.unset('createdEmail');\r",
                  "pm.collectionVariables.unset('duplicateEmailForRun');"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{runEmail}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. GET - Get Created User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.test('Returned user ID matches created user', function () {\r",
                  "        pm.expect(String(data.id)).to.eql(\r",
                  "            pm.environment.get('userId')\r",
                  "        );\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
